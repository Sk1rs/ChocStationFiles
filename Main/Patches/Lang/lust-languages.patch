diff --git a/Content.Server/_Lust/Languages/LanguageSystem.cs b/Content.Server/_Lust/Languages/LanguageSystem.cs
new file mode 100644
index 0000000000..6542ebd843
--- /dev/null
+++ b/Content.Server/_Lust/Languages/LanguageSystem.cs
@@ -0,0 +1,279 @@
+using System.Text;
+using System.Text.RegularExpressions;
+using Content.Shared._Lust.Languages;
+using Content.Shared._Lust.Languages.Components;
+using Content.Shared._Lust.Languages.Prototypes;
+using Content.Shared.Ghost.Components;
+using Content.Shared.Implants;
+using Content.Shared.Polymorph;
+using Content.Shared.Zombies;
+using Content.Shared.Humanoid;
+using Robust.Shared.Player;
+using Robust.Shared.Prototypes;
+
+namespace Content.Server._Lust.Languages;
+
+public sealed partial class LanguageSystem : EntitySystem
+{
+    [Dependency] private IPrototypeManager _prototype = default!;
+
+    public static readonly ProtoId<LanguagePrototype> Common = "GeneralLanguage";
+
+    private readonly Dictionary<ProtoId<LanguagePrototype>, List<Regex>> _regexCache = new();
+
+    private static readonly Dictionary<string, ProtoId<LanguagePrototype>> SpeciesLanguages = new()
+    {
+        ["Arachnid"] = "ArachnidLanguage",
+        ["Demon"] = "DemonLanguage",
+        ["Diona"] = "DionaLanguage",
+        ["Dwarf"] = "DwarfLanguage",
+        ["Felinid"] = "CatLanguage",
+        ["HumanoidXeno"] = "XenomorphLanguage",
+        ["Moth"] = "MothLanguage",
+        ["Reptilian"] = "ReptilianLanguage",
+        ["SlimePerson"] = "SlimeLanguage",
+        ["Tajaran"] = "CatLanguage",
+        ["Vox"] = "VoxLanguage",
+        ["Vulpkanin"] = "VulpkaninLanguage",
+    };
+
+    public override void Initialize()
+    {
+        SubscribeLocalEvent<HumanoidProfileComponent, MapInitEvent>(OnHumanoidInit);
+        SubscribeLocalEvent<HumanoidProfileComponent, VoiceChangedEvent>(OnProfileChanged);
+        SubscribeLocalEvent<HumanoidProfileComponent, PlayerAttachedEvent>(OnPlayerAttached);
+        SubscribeLocalEvent<LanguageComponent, PolymorphedEvent>(OnPolymorphed);
+        SubscribeLocalEvent<LearnLanguageImplantComponent, ImplantImplantedEvent>(OnImplanted);
+        SubscribeNetworkEvent<SelectLanguageEvent>(OnSelect);
+    }
+
+    private void OnHumanoidInit(Entity<HumanoidProfileComponent> ent, ref MapInitEvent args)
+    {
+        GrantSpeciesLanguages(ent);
+    }
+
+    private void OnProfileChanged(Entity<HumanoidProfileComponent> ent, ref VoiceChangedEvent args)
+    {
+        GrantSpeciesLanguages(ent);
+    }
+
+    private void OnPlayerAttached(Entity<HumanoidProfileComponent> ent, ref PlayerAttachedEvent args)
+    {
+        GrantSpeciesLanguages(ent);
+    }
+
+    private void GrantSpeciesLanguages(Entity<HumanoidProfileComponent> ent)
+    {
+        if (HasComp<ZombieComponent>(ent))
+            return;
+
+        var language = EnsureComp<LanguageComponent>(ent);
+        var changed = language.KnownLanguages.Add(Common);
+        if (SpeciesLanguages.TryGetValue(ent.Comp.Species.Id, out var native))
+            changed |= language.KnownLanguages.Add(native);
+
+        if (changed)
+            Dirty(ent, language);
+    }
+
+    private void OnPolymorphed(Entity<LanguageComponent> ent, ref PolymorphedEvent args)
+    {
+        var language = EnsureComp<LanguageComponent>(args.NewEntity);
+        language.KnownLanguages.UnionWith(ent.Comp.KnownLanguages);
+        language.CantSpeakLanguages.UnionWith(ent.Comp.CantSpeakLanguages);
+        language.SelectedLanguage = ent.Comp.SelectedLanguage;
+        Dirty(args.NewEntity, language);
+    }
+
+    public void SetZombieLanguage(EntityUid ent)
+    {
+        var language = EnsureComp<LanguageComponent>(ent);
+        language.KnownLanguages.Clear();
+        language.KnownLanguages.Add("ZombieLanguage");
+        language.CantSpeakLanguages.Clear();
+        language.UnlockLanguagesAfterMakeSentient.Clear();
+        language.SelectedLanguage = "ZombieLanguage";
+        Dirty(ent, language);
+    }
+
+    public void EnableSentientLanguages(EntityUid entity)
+    {
+        if (HasComp<ZombieComponent>(entity))
+            return;
+
+        var language = EnsureComp<LanguageComponent>(entity);
+        language.KnownLanguages.Add(Common);
+        language.CantSpeakLanguages.ExceptWith(language.UnlockLanguagesAfterMakeSentient);
+        language.KnownLanguages.UnionWith(language.UnlockLanguagesAfterMakeSentient);
+        Dirty(entity, language);
+    }
+
+    private void OnImplanted(Entity<LearnLanguageImplantComponent> ent, ref ImplantImplantedEvent args)
+    {
+        if (HasComp<ZombieComponent>(args.Implanted))
+            return;
+
+        var language = EnsureComp<LanguageComponent>(args.Implanted);
+        language.KnownLanguages.Add(Common);
+        language.KnownLanguages.UnionWith(ent.Comp.Language);
+        Dirty(args.Implanted, language);
+    }
+
+    private void OnSelect(SelectLanguageEvent message, EntitySessionEventArgs args)
+    {
+        if (args.SenderSession.AttachedEntity is not {} entity ||
+            !TryComp<LanguageComponent>(entity, out var language) ||
+            !language.KnownLanguages.Contains(message.PrototypeId) ||
+            language.CantSpeakLanguages.Contains(message.PrototypeId) ||
+            !_prototype.HasIndex(message.PrototypeId))
+        {
+            return;
+        }
+
+        language.SelectedLanguage = message.PrototypeId;
+        Dirty(entity, language);
+    }
+
+    public ProtoId<LanguagePrototype> GetSpokenLanguage(EntityUid source)
+    {
+        return TryComp<LanguageComponent>(source, out var language)
+            ? language.SelectedLanguage
+            : Common;
+    }
+
+    public bool KnowsLanguage(EntityUid? listener, ProtoId<LanguagePrototype> language)
+    {
+        if (HasComp<GhostComponent>(listener))
+            return true;
+
+        if (TryComp<LanguageComponent>(listener, out var component))
+            return component.KnownLanguages.Contains(language);
+
+        if (language == Common)
+            return true;
+
+        return _prototype.TryIndex(language, out var prototype) && prototype.CanBeUnderstoodWithoutKnowledge;
+    }
+
+    public LanguagePrototype? GetLanguage(EntityUid source)
+    {
+        var id = GetSpokenLanguage(source);
+        return _prototype.TryIndex(id, out var prototype) ? prototype : null;
+    }
+
+    public string GetLanguageLabel(ProtoId<LanguagePrototype> language)
+    {
+        return language != Common && _prototype.TryIndex(language, out var prototype)
+            ? $"[{Loc.GetString(prototype.Name)}] "
+            : string.Empty;
+    }
+
+    public static int GetDeterministicHashCode(string str) { unchecked { int hash1 = (5381 << 16) + 5381; int hash2 = hash1; for (int i = 0; i < str.Length; i += 2) { hash1 = ((hash1 << 5) + hash1) ^ str[i]; if (i + 1 < str.Length) hash2 = ((hash2 << 5) + hash2) ^ str[i + 1]; } return hash1 + (hash2 * 1566083941); } }
+
+    public string TransformWord(string word, ProtoId<LanguagePrototype>? languageId)
+    {
+        if (!_prototype.TryIndex(languageId, out var proto))
+            return word;
+
+        var hash = GetDeterministicHashCode(word + proto.ID);
+
+        switch (proto.SpeechMode)
+        {
+            case SpeechMode.Lexicon:
+                return TransformLexicon(hash, proto);
+
+            case SpeechMode.Alphabet:
+                return TransformAlphabet(hash, proto);
+
+            case SpeechMode.Syllable:
+                return TransformSyllableText(word, proto);
+
+            case SpeechMode.Pattern:
+                return TransformPattern(word, proto);
+
+            default:
+                return word;
+        }
+    }
+
+    private string TransformLexicon(int hash, LanguagePrototype proto)
+    {
+        var list = proto.Lexicon;
+        return list.Count == 0 ? string.Empty : list[(int)((uint)hash & int.MaxValue) % list.Count];
+    }
+
+    private string TransformAlphabet(int hash, LanguagePrototype proto)
+    {
+        var alphabet = proto.Alphabet;
+        if (alphabet.Count == 0)
+            return string.Empty;
+
+        int len = proto.GenerateLength;
+
+        var sb = new StringBuilder();
+
+        int localHash = hash;
+        for (int i = 0; i < len; i++)
+        {
+            int index = (int)((uint)localHash & int.MaxValue) % alphabet.Count;
+            sb.Append(alphabet[index]);
+
+            localHash = GetDeterministicHashCode(localHash.ToString());
+        }
+
+        return sb.ToString();
+    }
+
+    private string TransformSyllableText(string text, LanguagePrototype proto)
+    {
+        if (string.IsNullOrWhiteSpace(text) || proto.Syllables.Count == 0)
+            return text;
+
+        var words = text.Split(' ', StringSplitOptions.RemoveEmptyEntries);
+        var sb = new StringBuilder();
+
+        foreach (var word in words)
+        {
+            var hash = GetDeterministicHashCode(word + proto.ID);
+
+            int count = proto.MinSyllables +
+                ((int)((uint)hash & int.MaxValue) % (proto.MaxSyllables - proto.MinSyllables + 1));
+
+            var localHash = hash;
+            for (int i = 0; i < count; i++)
+            {
+                sb.Append(proto.Syllables[(int)((uint)localHash & int.MaxValue) % proto.Syllables.Count]);
+                localHash = GetDeterministicHashCode(localHash.ToString());
+            }
+
+            sb.Append(' ');
+        }
+
+        return sb.ToString().Trim();
+    }
+
+    private string TransformPattern(string word, LanguagePrototype proto)
+    {
+        if (!_regexCache.TryGetValue(proto.ID, out var regexList))
+        {
+            regexList = new List<Regex>(proto.Patterns.Count);
+
+            for (int i = 0; i < proto.Patterns.Count; i++)
+            {
+                var r = new Regex(
+                    proto.Patterns[i],
+                    RegexOptions.IgnoreCase | RegexOptions.Compiled
+                );
+                regexList.Add(r);
+            }
+
+            _regexCache[proto.ID] = regexList;
+        }
+
+        string result = word;
+        for (int i = 0; i < Math.Min(regexList.Count, proto.Replacements.Count); i++)
+            result = regexList[i].Replace(result, proto.Replacements[i]);
+
+        return result;
+    }
+}
