diff --git a/Content.Client/_Lust/Languages/LanguageUIController.cs b/Content.Client/_Lust/Languages/LanguageUIController.cs
new file mode 100644
index 0000000000..3eff9258b2
--- /dev/null
+++ b/Content.Client/_Lust/Languages/LanguageUIController.cs
@@ -0,0 +1,105 @@
+using System.Linq;
+using Content.Client.Gameplay;
+using Content.Shared.Input;
+using Robust.Shared.Input.Binding;
+using Content.Client.UserInterface.Controls;
+using Content.Client.UserInterface.Systems.MenuBar.Widgets;
+using Content.Shared._Lust.Languages.Components;
+using Content.Shared._Lust.Languages.Prototypes;
+using Robust.Client.Player;
+using Robust.Client.UserInterface.Controllers;
+using Robust.Client.UserInterface.Controls;
+using Robust.Shared.Prototypes;
+using Robust.Shared.Utility;
+
+namespace Content.Client._Lust.Languages;
+
+public sealed partial class LanguageUIController : UIController, IOnStateChanged<GameplayState>
+{
+    [Dependency] private IPlayerManager _player = default!;
+    [Dependency] private IPrototypeManager _prototype = default!;
+
+    private MenuButton? Button => UIManager.GetActiveUIWidgetOrNull<GameTopMenuBar>()?.LanguageButton;
+    private SimpleRadialMenu? _menu;
+
+    public void OnStateEntered(GameplayState state)
+    {
+        CommandBinds.Builder
+            .Bind(ContentKeyFunctions.OpenLanguageMenu, InputCmdHandler.FromDelegate(_ => ToggleMenu()))
+            .Register<LanguageUIController>();
+    }
+
+    public void OnStateExited(GameplayState state)
+    {
+        CommandBinds.Unregister<LanguageUIController>();
+        CloseMenu();
+    }
+
+    public void LoadButton()
+    {
+        if (Button is {} button)
+            button.OnPressed += OnPressed;
+    }
+
+    public void UnloadButton()
+    {
+        if (Button is {} button)
+            button.OnPressed -= OnPressed;
+
+        CloseMenu();
+    }
+
+    private void OnPressed(BaseButton.ButtonEventArgs args) => ToggleMenu();
+
+    private void ToggleMenu()
+    {
+        if (_menu != null)
+        {
+            CloseMenu();
+            return;
+        }
+
+        if (!EntityManager.TryGetComponent<LanguageComponent>(_player.LocalEntity, out var language))
+            return;
+
+        var buttons = new List<RadialMenuOptionBase>();
+        foreach (var id in language.KnownLanguages.OrderBy(id => id.Id))
+        {
+            if (language.CantSpeakLanguages.Contains(id) || !_prototype.TryIndex(id, out var prototype))
+                continue;
+
+            buttons.Add(new RadialMenuActionOption<ProtoId<LanguagePrototype>>(Select, id)
+            {
+                IconSpecifier = RadialMenuIconSpecifier.With(prototype.Icon ??
+                    new SpriteSpecifier.Texture(new ResPath("/Textures/_Lust/Languages/LanguageIcons/default.png"))),
+                ToolTip = id == language.SelectedLanguage
+                    ? Loc.GetString("lust-language-selected", ("language", Loc.GetString(prototype.Name)))
+                    : Loc.GetString(prototype.Name),
+            });
+        }
+
+        if (buttons.Count == 0)
+            return;
+
+        _menu = new SimpleRadialMenu();
+        _menu.SetButtons(buttons);
+        _menu.OnClose += CloseMenu;
+        _menu.OpenCentered();
+    }
+
+    private void Select(ProtoId<LanguagePrototype> language)
+    {
+        EntityManager.System<LanguageSystem>().Select(language);
+        CloseMenu();
+    }
+
+    private void CloseMenu()
+    {
+        if (_menu is not {} menu)
+            return;
+
+        _menu = null;
+        menu.OnClose -= CloseMenu;
+        menu.Dispose();
+    }
+}
