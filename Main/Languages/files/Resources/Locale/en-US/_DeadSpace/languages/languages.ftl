## Language-tagged lines. Only listeners who know the language see these; everyone else gets the plain line in gibberish.
chat-manager-entity-say-wrap-message-lang = [BubbleHeader][bold][Name]{$entityName}[/Name][/bold][/BubbleHeader] {$verb} [italic]({$language})[/italic], [font={$fontType} size={$fontSize}]"[BubbleContent]{$message}[/BubbleContent]"[/font]
chat-manager-entity-say-bold-wrap-message-lang = [BubbleHeader][bold][Name]{$entityName}[/Name][/bold][/BubbleHeader] {$verb} [italic]({$language})[/italic], [font={$fontType} size={$fontSize}]"[BubbleContent][bold]{$message}[/bold][/BubbleContent]"[/font]
chat-manager-entity-whisper-wrap-message-lang = [font size=11][italic][BubbleHeader][Name]{$entityName}[/Name][/BubbleHeader] whispers ({$language}),"[BubbleContent]{$message}[/BubbleContent]"[/italic][/font]
chat-radio-message-wrap-lang = [color={$color}]{$channel} [bold]{$name}[/bold] {$verb} [italic]({$language})[/italic], [font={$fontType} size={$fontSize}]"{$message}"[/font][/color]
chat-radio-message-wrap-bold-lang = [color={$color}]{$channel} [bold]{$name}[/bold] {$verb} [italic]({$language})[/italic], [font={$fontType} size={$fontSize}][bold]"{$message}"[/bold][/font][/color]
